# Local configuration. Copy to .env and fill only what you need.
# Never commit the real .env file.

# Host database (PostgreSQL 16 started by docker-compose.yml).
ConnectionStrings__SprintUp=Host=localhost;Port=5432;Database=sprintup;Username=sprintup;Password=sprintup

# Integration tests. The database must be empty; the fixture creates and drops
# its own per-run schema. Use this when Docker is unavailable and a local
# PostgreSQL 16 instance (for example Podman) is running instead.
TEST_DB_CONNECTION=Host=localhost;Port=5432;Database=sprintup_test;Username=sprintup;Password=sprintup

# Strava OAuth application. Read-only scopes only.
Strava__ClientId=
Strava__ClientSecret=
Strava__RedirectUri=http://localhost:5080/integrations/strava/callback

# Data Protection key ring. Required outside Development.
DataProtection__KeysPath=/var/lib/sprintup/data-protection-keys

# Operator bootstrap account. Required outside Development; the default
# password is refused.
Admin__BootstrapEmail=admin@example.com
Admin__BootstrapPassword=

# docker-compose.yml only.
POSTGRES_DB=sprintup
POSTGRES_USER=sprintup
POSTGRES_PASSWORD=sprintup
POSTGRES_PORT=5432
